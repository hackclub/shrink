DATABASE_URL="postgres://localhost:5432/shrink"

# openssl rand -hex 32. Encrypts stored tokens and shipping addresses; rotating it makes them unreadable.
ENCRYPTION_KEY=

# Development only. Staging is on under `next dev` when HCA_CLIENT_ID is unset.
# STAGING=1
# STAGING_ROLE=admin

# Hack Club Auth. Redirect URI: https://<host>/api/auth/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# HCA_SCOPES="openid profile email slack_id verification_status address birthdate"

# Hackatime OAuth. Redirect URI: https://<host>/api/auth/hackatime/callback
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

NEXT_PUBLIC_PROGRAM_START=2026-09-29
NEXT_PUBLIC_PROGRAM_END=2026-10-13

# Optional: pre-ship scan
GITHUB_TOKEN=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Optional: Slack bot from slack/manifest.json (channels:write.invites, chat:write,
# chat:write.public, users:read, users:read.email)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Channel people are invited to after /welcome (defaults to #shrink; set empty to disable)
SLACK_PROGRAM_CHANNEL_ID=
# DMs participants about ship decisions and orders; set to 0 to turn off (on by default)
SLACK_DMS=
# Secret the Slack "join" button sends to POST /api/slack/join. With users:read
# and users:read.email on the bot, joined users get their Slack name and email.
SLACK_JOIN_SECRET=

# Optional: Airtable mirror (Users, Ships, Orders) + YSWS Project Submission on approval.
# Table names default to those; override with AIRTABLE_{USERS,SHIPS,ORDERS,YSWS}_TABLE.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Bearer token for GET /api/cron/airtable (full resync)
CRON_SECRET=
# Public origin, e.g. https://shrink.hackclub.com (used for links in Airtable)
APP_URL=

# Comma-separated; promoted to admin on sign-in
ADMIN_EMAILS=
# ADMIN_HCA_SUBJECTS=

# Vercel Web Analytics, for the "visited" count on /stats. Token from
# vercel.com/account/tokens; project and team IDs from the project settings.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Shown instead when the above is unset.
# STATS_VISITORS=540
